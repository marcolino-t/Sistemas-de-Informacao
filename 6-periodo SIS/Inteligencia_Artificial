      "cell_type": "code",
      "source": [
        "# cart_vs_mlp_digits .py\n",
        "import numpy as np\n",
        "import matplotlib . pyplot as plt\n",
        "\n",
        "from sklearn . datasets import load_digits\n",
        "from sklearn . model_selection import train_test_split , GridSearchCV\n",
        "from sklearn . metrics import (\n",
        "    accuracy_score , classification_report ,\n",
        "    ConfusionMatrixDisplay\n",
        ")\n",
        "from sklearn . tree import DecisionTreeClassifier , plot_tree\n",
        "from sklearn . neural_network import MLPClassifier\n",
        "from sklearn . preprocessing import StandardScaler\n",
        "from sklearn . pipeline import Pipeline\n",
        "from joblib import dump , load"
      ],
      "metadata": {
        "id": "XxzGvpeimyfr"
      },
      "execution_count": 1,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [],
      "metadata": {
        "id": "s1xWIXQiFFir"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 1) Dados\n",
        "digits = load_digits ()\n",
        "X , y = digits . data , digits . target\n",
        "class_names = digits . target_names # np. array ([0..9])"
      ],
      "metadata": {
        "id": "WR4oMoInm0Uf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        " # 2) Split estratificado 70/30\n",
        "X_tr , X_te , y_tr , y_te = train_test_split (\n",
        "X , y , test_size =0.30 , random_state =42 , stratify = y\n",
        ")"
      ],
      "metadata": {
        "id": "YSsLWTDJm2XK"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 3) CART (Decision Tree) + Busca de Hiperparâmetros\n",
        "\n",
        "dt = DecisionTreeClassifier(random_state=42)\n",
        "\n",
        "grid_dt = GridSearchCV(\n",
        "    dt,\n",
        "    param_grid={\n",
        "        \"criterion\": [\"gini\", \"entropy\"],\n",
        "        \"max_depth\": [10],  # agora VARIANDO max_depth\n",
        "        \"min_samples_leaf\": [1, 2, 5, 10],\n",
        "        \"ccp_alpha\": [0.0, 1e-4, 1e-3, 1e-2],  # poda custo-complexidade\n",
        "    },\n",
        "    cv=5,\n",
        "    n_jobs=-1,\n",
        "    scoring=\"accuracy\",\n",
        "    refit=True\n",
        ")\n",
        "\n",
        "grid_dt.fit(X_tr, y_tr)\n",
        "best_dt = grid_dt.best_estimator_\n",
        "\n",
        "print(\"[CART] Best params:\", grid_dt.best_params_)\n",
        "print(\"[CART] CV acc:\", grid_dt.best_score_)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "m902vVEbm5Dq",
