          "text": [
            "[CART] Best params: {'ccp_alpha': 0.001, 'criterion': 'gini', 'max_depth': 10, 'min_samples_leaf': 1}\n",
            "[CART] CV acc: 0.8591570227028396\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 4) MLP (Pipeline com StandardScaler) + Busca de Hiperparâmetros\n",
        "pipe_mlp = Pipeline([\n",
        "    (\"scaler\", StandardScaler()),\n",
        "    (\"mlp\", MLPClassifier(max_iter=300, random_state=42))\n",
        "])\n",
        "grid_mlp = GridSearchCV(\n",
        "    pipe_mlp,\n",
        "    param_grid={\n",
        "        \"mlp__hidden_layer_sizes\": [(256,), (128,), (64, 32), (128, 64)],\n",
        "        \"mlp__alpha\": [1e-5, 1e-4, 1e-3],  # Regularização L2 (weight decay)\n",
        "        \"mlp__learning_rate_init\": [1e-3, 5e-3, 1e-2],  # Taxa de aprendizado inicial\n",
        "    },\n",
        "    cv=5,\n",
        "    n_jobs=-1,\n",
        "    scoring=\"accuracy\",\n",
        "    refit=True\n",
        ")\n",
        "\n",
        "grid_mlp.fit(X_tr, y_tr)\n",
        "\n",
        "best_mlp = grid_mlp.best_estimator_\n",
        "\n",
        "print(\"[MLP] Best params:\", grid_mlp.best_params_)\n",
        "print(\"[MLP] CV acc:\", grid_mlp.best_score_)"
      ],
